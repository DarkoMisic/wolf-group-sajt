---
import Logo from './Logo.astro';
import LegalData from './LegalData.astro';
import { legal } from '../i18n/legal';
import { t, pathFor, alternates, type Lang, type PageKey } from '../i18n/utils';
import { navPages } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__mark">
      <Logo variant="mark" height={44} alt="Wolf Group" />
    </div>

    <LegalData lang={lang} />

    <nav class="site-footer__nav" aria-label={d.ui.mainNav}>
      <ul>
        {navPages.map((p) => <li><a href={pathFor(p, lang)}>{d.nav[p as keyof typeof d.nav]}</a></li>)}
      </ul>
    </nav>

    <ul class="site-footer__lang" aria-label={d.ui.language}>
      {
        alternates(page).map((l) => (
          <li>
            <a href={l.path} hreflang={l.lang} lang={l.lang} aria-current={l.lang === lang ? 'true' : undefined}>
              {l.lang === 'sr' ? 'Srpski' : 'English'}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container site-footer__bottom">
    <span>© {year} {legal.company}</span>
    <a href={pathFor('privacy', lang)}>{d.nav.privacy}</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    background: var(--bg-alt);
    border-top: 1px solid var(--gold);
    font-size: var(--fs-small);
    color: var(--ink);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: auto 2fr 1fr auto;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-4);
    align-items: start;
  }
  .site-footer__mark :global(img) {
    height: 44px;
    width: auto;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__nav li,
  .site-footer__lang li {
    margin-bottom: 0.35rem;
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }
  .site-footer__lang a {
    color: var(--muted);
  }
  .site-footer__lang a[aria-current='true'] {
    color: var(--ink);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 60rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__mark {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
