---
// JEDINO mesto gde se referenciraju fajlovi logoa Wolf Group.
// Izvor: SVG od dizajnera (logo/svg/, original u logo/vektor/).
import horizontalGold from '../assets/logo/wolf-group-horizontal-gold.svg';
import horizontalWhite from '../assets/logo/wolf-group-horizontal-white.svg';
import horizontalBlack from '../assets/logo/wolf-group-horizontal-black.svg';
import verticalGold from '../assets/logo/wolf-group-vertical-gold.svg';
import verticalWhite from '../assets/logo/wolf-group-vertical-white.svg';
import verticalBlack from '../assets/logo/wolf-group-vertical-black.svg';
import markGold from '../assets/logo/wolf-group-mark-gold.svg';
import markWhite from '../assets/logo/wolf-group-mark-white.svg';
import markBlack from '../assets/logo/wolf-group-mark-black.svg';

const files = {
  horizontal: { gold: horizontalGold, white: horizontalWhite, black: horizontalBlack },
  vertical: { gold: verticalGold, white: verticalWhite, black: verticalBlack },
  mark: { gold: markGold, white: markWhite, black: markBlack },
};

interface Props {
  variant?: 'horizontal' | 'vertical' | 'mark';
  tone?: 'gold' | 'white' | 'black';
  height: number;
  alt?: string;
  eager?: boolean;
  class?: string;
}

const { variant = 'horizontal', tone = 'gold', height, alt = 'Wolf Group', eager = false, class: className } = Astro.props;
const src = files[variant][tone];
const width = Math.round((src.width / src.height) * height);
---

<img
  src={src.src}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class:list={['logo', `logo--${variant}`, className]}
/>
