---
// Fotografija u fiksnim proporcijama, AVIF/WebP, lazy load.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string; // npr. '2 / 3', '3 / 2'
  sizes?: string;
  position?: string; // object-position
  caption?: string;
  class?: string;
}

const { src, alt, ratio = '3 / 2', sizes = '100vw', position = 'center', caption, class: className } = Astro.props;
---

<figure class:list={['photo', className]} style={`--ratio: ${ratio}; --pos: ${position}`}>
  <div class="photo__frame">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
  }
  .photo__frame {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--bg-alt);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }
  figcaption {
    margin-top: var(--space-1);
    font-size: var(--fs-small);
    color: var(--muted);
    letter-spacing: 0.02em;
  }
</style>
